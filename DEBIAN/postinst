#!/bin/sh

set -eu

echo "Running WeaponX RootHide post-installation script..."

WEAPONX_DIR="/var/mobile/Library/WeaponX"
GUARDIAN_DIR="/Library/WeaponX/Guardian"
LIBSANDY_PROFILE="/Library/libSandy/projectx_filesystem_access.plist"
SANDBOX_PROFILE="/Library/Sandbox/Profile/projectx_filesystem_access.plist"
LAUNCHDAEMON_PATH="/Library/LaunchDaemons/com.hydra.weaponx.guardian.plist"
LAUNCHDAEMON_LABEL="com.hydra.weaponx.guardian"
LAUNCHCTL="/bin/launchctl"

echo "Creating RootHide data and daemon directories..."
mkdir -p "$WEAPONX_DIR" "$GUARDIAN_DIR" "/Library/Sandbox/Profile"
chmod 755 "$WEAPONX_DIR" "$GUARDIAN_DIR" "/Library/Sandbox/Profile"
chown mobile:mobile "$WEAPONX_DIR"
chown root:wheel "$GUARDIAN_DIR" "/Library/Sandbox/Profile"

# Only the package-owned, argument-restricted IDFV helper may run without a password.
# Temporary mobile-owned workers are deliberately not authorized.
VENDOR_HELPER="/Library/WeaponX/ProjectXAppStateVendorWorker"
SUDO_RULE="/etc/sudoers.d/projectx-app-state"
chown root:wheel "/Library/WeaponX" "$VENDOR_HELPER"
chmod 755 "/Library/WeaponX" "$VENDOR_HELPER"
VENDOR_NATIVE=$(/usr/bin/jbroot "$VENDOR_HELPER")
# RootHide's realpath CLI converts bootstrap paths back to logical paths.
# Keep the native path returned by jbroot, as for the existing ZXTouch rule.
case "$VENDOR_NATIVE" in
    /*) ;;
    *) echo "error: Cannot resolve IDFV helper" >&2; exit 1 ;;
esac
case "$VENDOR_NATIVE" in
    *[!a-zA-Z0-9/._-]*) echo "error: Invalid IDFV helper path" >&2; exit 1 ;;
esac
mkdir -p /etc/sudoers.d
SUDO_TEMP=$(mktemp /etc/sudoers.d/.projectx-app-state.XXXXXX)
trap 'rm -f "$SUDO_TEMP"' EXIT HUP INT TERM
printf 'mobile ALL=(root) NOPASSWD: %s\n' "$VENDOR_NATIVE" > "$SUDO_TEMP"
chown root:wheel "$SUDO_TEMP"
chmod 440 "$SUDO_TEMP"
# Procursus installs this library under libexec/sudo, while this device's
# visudo rpath looks under usr/lib. Supply the trusted bootstrap library path
# only to this validation process, without changing global files or libraries.
SUDO_LIBRARIES=$(/usr/bin/jbroot /usr/libexec/sudo)
/usr/bin/env "DYLD_LIBRARY_PATH=$SUDO_LIBRARIES" /usr/sbin/visudo -cf "$SUDO_TEMP"
mv -f "$SUDO_TEMP" "$SUDO_RULE"
trap - EXIT HUP INT TERM
/usr/bin/sudo -n -l -U mobile "$VENDOR_NATIVE" --check

CURRENT_PROFILE="$WEAPONX_DIR/current_profile.plist"
if [ ! -f "$CURRENT_PROFILE" ]; then
    cat > "$CURRENT_PROFILE" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>ProfileName</key><string>ProjectX</string>
  <key>values</key><dict/>
</dict></plist>
PLIST
    chmod 644 "$CURRENT_PROFILE"
    chown mobile:mobile "$CURRENT_PROFILE"
fi

if [ ! -f "$LIBSANDY_PROFILE" ]; then
    echo "error: LibSandy profile not found at $LIBSANDY_PROFILE" >&2
    exit 1
fi
cp -f "$LIBSANDY_PROFILE" "$SANDBOX_PROFILE"
chmod 644 "$LIBSANDY_PROFILE" "$SANDBOX_PROFILE"
chown root:wheel "$LIBSANDY_PROFILE" "$SANDBOX_PROFILE"

echo "Creating guardian logs..."
touch "$GUARDIAN_DIR/daemon.log" \
      "$GUARDIAN_DIR/guardian-stderr.log" \
      "$GUARDIAN_DIR/guardian-stdout.log"
chmod 664 "$GUARDIAN_DIR"/*.log
chown root:wheel "$GUARDIAN_DIR"/*.log

if [ ! -f "$LAUNCHDAEMON_PATH" ]; then
    echo "error: LaunchDaemon plist not found at $LAUNCHDAEMON_PATH" >&2
    exit 1
fi
if [ ! -x "$LAUNCHCTL" ]; then
    echo "error: RootHide launchctl not found at $LAUNCHCTL" >&2
    exit 1
fi

chmod 644 "$LAUNCHDAEMON_PATH"
chown root:wheel "$LAUNCHDAEMON_PATH"
"$LAUNCHCTL" bootout "system/$LAUNCHDAEMON_LABEL" 2>/dev/null || true
"$LAUNCHCTL" bootstrap system "$LAUNCHDAEMON_PATH"

echo "WeaponX RootHide installation completed."
exit 0
