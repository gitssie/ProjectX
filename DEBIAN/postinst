#!/bin/sh

set -eu

echo "Running WeaponX RootHide post-installation script..."

WEAPONX_DIR="/var/mobile/Library/WeaponX"
GUARDIAN_DIR="/Library/WeaponX/Guardian"
LIBSANDY_PROFILE="/Library/libSandy/projectx_filesystem_access.plist"
SANDBOX_PROFILE="/Library/Sandbox/Profile/projectx_filesystem_access.plist"
LAUNCHDAEMON_PATH="/Library/LaunchDaemons/com.hydra.weaponx.guardian.plist"
LAUNCHDAEMON_LABEL="com.hydra.weaponx.guardian"
LAUNCHCTL="/bin/launchctl"

echo "Creating RootHide data and daemon directories..."
mkdir -p "$WEAPONX_DIR" "$GUARDIAN_DIR" "/Library/Sandbox/Profile"
chmod 755 "$WEAPONX_DIR" "$GUARDIAN_DIR" "/Library/Sandbox/Profile"
chown mobile:mobile "$WEAPONX_DIR"
chown root:wheel "$GUARDIAN_DIR" "/Library/Sandbox/Profile"

if [ ! -f "$LIBSANDY_PROFILE" ]; then
    echo "error: LibSandy profile not found at $LIBSANDY_PROFILE" >&2
    exit 1
fi
cp -f "$LIBSANDY_PROFILE" "$SANDBOX_PROFILE"
chmod 644 "$LIBSANDY_PROFILE" "$SANDBOX_PROFILE"
chown root:wheel "$LIBSANDY_PROFILE" "$SANDBOX_PROFILE"

echo "Creating guardian logs..."
touch "$GUARDIAN_DIR/daemon.log" \
      "$GUARDIAN_DIR/guardian-stderr.log" \
      "$GUARDIAN_DIR/guardian-stdout.log"
chmod 664 "$GUARDIAN_DIR"/*.log
chown root:wheel "$GUARDIAN_DIR"/*.log

if [ ! -f "$LAUNCHDAEMON_PATH" ]; then
    echo "error: LaunchDaemon plist not found at $LAUNCHDAEMON_PATH" >&2
    exit 1
fi
if [ ! -x "$LAUNCHCTL" ]; then
    echo "error: RootHide launchctl not found at $LAUNCHCTL" >&2
    exit 1
fi

chmod 644 "$LAUNCHDAEMON_PATH"
chown root:wheel "$LAUNCHDAEMON_PATH"
"$LAUNCHCTL" bootout "system/$LAUNCHDAEMON_LABEL" 2>/dev/null || true
"$LAUNCHCTL" bootstrap system "$LAUNCHDAEMON_PATH"

echo "WeaponX RootHide installation completed."
exit 0
