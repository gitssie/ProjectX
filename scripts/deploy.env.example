# Copy to ProjectX/.deploy/deploy.env.
# Replace every placeholder with a local absolute path, host, or port.
# Keep ProjectX/.deploy untracked and chmod the resulting file 600.

THEOS="/absolute/path/to/<roothide-theos>"
PROJECTX_SILEO_SOURCE_URL="http://127.0.0.1:<device-port>"
PROJECTX_SILEO_HTTP_PORT="<mac-loopback-port>"
PROJECTX_SILEO_DEVICE_PORT="<device-port>"
PROJECTX_SILEO_SSH_HOST="<iproxy-host>"
PROJECTX_SILEO_SSH_PORT="<iproxy-port>"
PROJECTX_SILEO_SSH_USER="mobile"
PROJECTX_SILEO_SSH_IDENTITY="/absolute/path/to/<authorized-mobile-key>"

# Optional standalone publish override. Normally leave this commented out.
# PROJECTX_SILEO_PACKAGE="/absolute/path/to/current-package.deb"
